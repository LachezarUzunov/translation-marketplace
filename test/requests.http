@base = http://localhost:4004/odata/v4

### Без логин -> 401
GET {{base}}/buyer/Offers

### Купувач: каталогът (очакваш 3 оферти)
GET {{base}}/buyer/Offers
Authorization: Basic buyer1:pass

### Купувач: каталог само за превод към български
GET {{base}}/buyer/Offers?$filter=targetLanguage eq 'bg'
Authorization: Basic buyer1:pass

### Купувач в услугата на преводача -> 403
GET {{base}}/translator/LanguagePairs
Authorization: Basic buyer1:pass

### Преводач: само своите езикови двойки (очакваш 2)
GET {{base}}/translator/LanguagePairs?$expand=offers
Authorization: Basic translator1:pass

### Преводач: опит да създаде вече одобрена двойка
POST {{base}}/translator/LanguagePairs
Authorization: Basic translator1:pass
Content-Type: application/json

{ "sourceLanguage": "it", "targetLanguage": "bg", "yearsExperience": 5, "status": "Approved" }

### Админ: всички езикови двойки
GET {{base}}/admin/LanguagePairs
Authorization: Basic admin:pass

### Преводач: нова двойка (translator_ID трябва да е translator1)
POST {{base}}/translator/LanguagePairs
Authorization: Basic translator1:pass
Content-Type: application/json

{ "sourceLanguage": "it", "targetLanguage": "bg", "yearsExperience": 5 }

### Преводач 1 опитва оферта към двойката на преводач 2 -> 403
POST {{base}}/translator/Offers
Authorization: Basic translator1:pass
Content-Type: application/json

{ "languagePair_ID": "33333333-3333-3333-3333-333333333333", "type": "Translation", "pricePerWord": 0.05 }

### Преводач 1 създава оферта към своя двойка -> 201, status Pending
POST {{base}}/translator/Offers
Authorization: Basic translator1:pass
Content-Type: application/json

{ "languagePair_ID": "11111111-1111-1111-1111-111111111111", "type": "Certified", "pricePerWord": 0.12 }
### Преводач 1 опитва да премести своя оферта към чужда двойка -> 400
PATCH {{base}}/translator/Offers(aaaaaaaa-0000-0000-0000-000000000001)
Authorization: Basic translator1:pass
Content-Type: application/json

{ "languagePair_ID": "33333333-3333-3333-3333-333333333333" }

### Смяна на цената -> status става Pending
PATCH {{base}}/translator/Offers(aaaaaaaa-0000-0000-0000-000000000002)
Authorization: Basic translator1:pass
Content-Type: application/json

{ "pricePerWord": 0.035 }

### Теглене над баланса -> 400
POST {{base}}/translator/Withdrawals
Authorization: Basic translator1:pass
Content-Type: application/json

{ "amount": 50 }

### Поръчка към неактивна оферта -> 400
POST {{base}}/buyer/Orders
Authorization: Basic buyer1:pass
Content-Type: application/json

{ "offer_ID": "aaaaaaaa-0000-0000-0000-000000000004", "wordCount": 100, "title": "Test" }

### Поръчка с wordCount 0 -> 400 (ASSERT_RANGE)
POST {{base}}/buyer/Orders
Authorization: Basic buyer1:pass
Content-Type: application/json

{ "offer_ID": "aaaaaaaa-0000-0000-0000-000000000001", "wordCount": 0, "title": "Test" }

### Купувач: цена за 1000 думи (очакваш buyerPrice 96)
GET {{base}}/buyer/quote(offer=aaaaaaaa-0000-0000-0000-000000000001,wordCount=1000)
Authorization: Basic buyer1:pass

### Купувач: цена за 100 думи, минимална комисионна (очакваш 18)
GET {{base}}/buyer/quote(offer=aaaaaaaa-0000-0000-0000-000000000001,wordCount=100)
Authorization: Basic buyer1:pass

### Купувач: зареждане на 100 кредита
POST {{base}}/buyer/topUp
Authorization: Basic buyer1:pass
Content-Type: application/json

{ "amount": 100 }

### Купувач: поръчка 1000 думи (96 кредита). status/buyer_ID/buyerPrice се игнорират
POST {{base}}/buyer/Orders
Authorization: Basic buyer1:pass
Content-Type: application/json

{ "offer_ID": "aaaaaaaa-0000-0000-0000-000000000001", "wordCount": 1000, "title": "Contract", "status": "Completed", "buyerPrice": 1 }

### Купувач: баланс (очакваш 4.00 след горните две)
GET {{base}}/buyer/Me
Authorization: Basic buyer1:pass

### Купувач: леджър (TopUp +100, Hold -96)
GET {{base}}/buyer/Transactions
Authorization: Basic buyer1:pass

### Преводач: вижда поръчката с translatorPrice, без buyerPrice
GET {{base}}/translator/Orders
Authorization: Basic translator1:pass
